# Server-only placeholders; do not copy real credentials into committed files.
PERSONAL_PORT=4310
# PERSONAL_DATA_DIR=/var/lib/personal-workspace
# Production: configure authenticated + private using the Paperclip CLI.
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
PI_TELEMETRY=0
PI_SKIP_VERSION_CHECK=1
# PERSONAL_PI_COMMAND=/opt/personal-workspace/tools/node_modules/.bin/pi
# PERSONAL_PI_MODEL=provider/model
# Model credentials: prefer upstream AI connections / encrypted secret references.
# Notion: use the backend Apps OAuth gateway; do not inject tokens into the browser/Agent.
# SSH: configure a dedicated non-root identity and pinned host key in Environments.
